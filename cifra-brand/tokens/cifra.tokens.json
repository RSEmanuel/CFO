{
  "$schema": "https://design-tokens.org/schema.json",
  "brand": {
    "name": "Cifra",
    "descriptor": "CFO virtual",
    "parent": "Data Frontier",
    "tagline": "Tus cifras, en claro."
  },
  "color": {
    "light": {
      "brand": "#1550E0",
      "brandSoft": "#DEE6FC",
      "brandContrast": "#FFFFFF",
      "paper": "#F1F3FB",
      "surface": "#FFFFFF",
      "surface2": "#E4E8F7",
      "ink": "#101425",
      "ink2": "#3B4260",
      "ink3": "#646B85",
      "line": "#D2D8EE",
      "line2": "#E5E9F6",
      "good": "#0D7350",
      "goodSoft": "#D9EDE5",
      "warn": "#8A5A05",
      "warnSoft": "#F4E9D3",
      "bad": "#9B2C20",
      "badSoft": "#F5DEDA"
    },
    "dark": {
      "brand": "#7E97FF",
      "brandSoft": "#141E46",
      "brandContrast": "#080A14",
      "paper": "#080A14",
      "surface": "#111528",
      "surface2": "#191E36",
      "ink": "#E8EBF7",
      "ink2": "#AEB5D0",
      "ink3": "#78809E",
      "line": "#272D4A",
      "line2": "#1C2239",
      "good": "#4BC698",
      "goodSoft": "#0C2C23",
      "warn": "#D8A455",
      "warnSoft": "#2E2410",
      "bad": "#EC8579",
      "badSoft": "#361A17"
    }
  },
  "font": {
    "sans": {
      "family": "Manrope",
      "weights": [
        400,
        500,
        600,
        700,
        800
      ],
      "use": "Todo lo que se lee: UI, titulares, copy"
    },
    "mono": {
      "family": "Azeret Mono",
      "weights": [
        400,
        500,
        700
      ],
      "use": "Todo lo que se cuenta: cifras, KPIs, tablas, ejes. tabular-nums obligatorio"
    }
  },
  "radius": {
    "base": "10px",
    "lg": "15px"
  },
  "proportion": {
    "colorMix": "60% paper / 30% ink+grafito / 10% brand",
    "signalMax": "Los tres colores de senal juntos nunca pasan del 2% de una pantalla"
  }
}
