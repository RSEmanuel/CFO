# -----------------------------------------------------------------------------
# PostgreSQL en AWS RDS (Prisma ORM)
# Formato: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public&sslmode=require
# Codifica caracteres especiales del password (ej. @ -> %40, # -> %23).
# -----------------------------------------------------------------------------
DATABASE_URL="postgresql://cfo_app:CHANGE_ME@cfo-virtual.xxxxx.us-east-1.rds.amazonaws.com:5432/cfo_virtual?schema=public&sslmode=require&connection_limit=10"

# Conexión directa (sin PgBouncer / RDS Proxy). Usada por Prisma Migrate.
DIRECT_URL="postgresql://cfo_app:CHANGE_ME@cfo-virtual.xxxxx.us-east-1.rds.amazonaws.com:5432/cfo_virtual?schema=public&sslmode=require"

# Base sombra para `prisma migrate dev` (debe ser una BD vacía aparte).
SHADOW_DATABASE_URL="postgresql://cfo_app:CHANGE_ME@cfo-virtual.xxxxx.us-east-1.rds.amazonaws.com:5432/cfo_virtual_shadow?schema=public&sslmode=require"

# Conexiones simultáneas del pool de `pg`. Con la base local de `prisma dev` el
# máximo soportado es 4; en RDS puede subir a 10 o más.
DATABASE_POOL_MAX="10"

# -----------------------------------------------------------------------------
# AWS Cognito (JWT)
# User Pool: habilitar USER_PASSWORD_AUTH en el app client.
# Atributos custom: custom:tenantId, custom:role
# Grupos: ADMIN, CFO_PARTNER, CLIENT_VIEWER
# El primer ADMIN se crea en consola Cognito + fila en Prisma (users.cognitoSub).
# -----------------------------------------------------------------------------
AWS_REGION="us-east-1"
COGNITO_USER_POOL_ID="us-east-1_xxxxxxxxx"
COGNITO_CLIENT_ID="xxxxxxxxxxxxxxxxxxxxxxxxxx"
# Obligatorio si el app client es confidencial (tiene secret).
COGNITO_CLIENT_SECRET=""

# Credenciales locales. En ECS/Lambda usar el rol de la tarea (no keys en env).
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# -----------------------------------------------------------------------------
# Modo desarrollo sin Cognito (opcional).
# Con "true", POST /api/auth/login acepta cualquier contraseña y resuelve el
# usuario como CFO_PARTNER del tenant demo CSI.
# NEXT_PUBLIC_DEV_AUTH_BYPASS habilita auto-login en el navegador.
# Se ignora cuando NODE_ENV=production.
# -----------------------------------------------------------------------------
DEV_AUTH_BYPASS="false"
NEXT_PUBLIC_DEV_AUTH_BYPASS="false"

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
